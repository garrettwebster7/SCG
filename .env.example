# Springfield Concrete Group - environment variables
#
# Copy to .env.local for local dev. In production, set these in Vercel ->
# Project -> Settings -> Environment Variables. NEVER commit real values.
#
# [REQUIRED]  the site/CRM won't save or log in without it
# [SECRET]    server-only; never prefix with NEXT_PUBLIC_, never paste in chat or commit
# [PUBLIC]    NEXT_PUBLIC_*: shipped to the browser, safe to expose

# ── Site ────────────────────────────────────────────────────────────────────
# [REQUIRED] Your live URL, no trailing slash. Used for quote links, SEO and the
# CRM login allowlist fallback (company email domain).
NEXT_PUBLIC_SITE_URL=https://www.springfieldconcretegroup.com

# ── Supabase (Project Settings -> API) ──────────────────────────────────────
# [REQUIRED][PUBLIC] Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# [REQUIRED][PUBLIC] anon / publishable key (RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [REQUIRED][SECRET] service_role / secret key: the CRM, uploads and cron jobs use it
SUPABASE_SERVICE_ROLE_KEY=
# [optional] Server-side override of the URL; defaults to NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=

# ── CRM access ──────────────────────────────────────────────────────────────
# Who may sign in to /crm. With both unset, only emails at your site's domain
# (from NEXT_PUBLIC_SITE_URL) are allowed. Comma-separated.
CRM_ALLOWED_EMAILS=
CRM_ALLOWED_DOMAINS=
# [optional] Restrict to staff roles (owner,contractor). Unset = any active staff role.
CRM_ALLOWED_ROLES=

# ── Owner / notifications ───────────────────────────────────────────────────
# [optional] First name used in the first text a customer gets
# ("this is Sam with Springfield Concrete Group"). Unset = just the business name.
OWNER_NAME=
# [recommended] Your mobile, E.164 (+12175550100): new-lead and alert texts go here
OWNER_PHONE=
# [optional] Number crews call when they can't make it. Defaults to the site phone.
OWNER_CALL_NUMBER=
# [optional] Google review link added to the job-complete thank-you text
GOOGLE_REVIEW_URL=
# [optional] Minutes between reminder texts to the same person (default 15)
REMINDER_SPACING_MINUTES=

# ── SMS provider (pick ONE; texts are skipped if none is set) ───────────────
# [optional] quo | twilio | custom. Unset: quo if QUO_API_KEY is set, else twilio.
SMS_PROVIDER=
# Quo (OpenPhone)
QUO_API_KEY=            # [SECRET]
QUO_FROM=               # E.164, e.g. +12175550100
QUO_USER_ID=            # optional
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=      # [SECRET]
TWILIO_FROM=            # E.164
# Custom HTTP endpoint (POSTs { to, from, message })
SMS_API_URL=
SMS_API_KEY=            # [SECRET]
SMS_FROM=

# ── Cron (vercel.json) ──────────────────────────────────────────────────────
# [REQUIRED for reminders][SECRET] Any long random string. Vercel sends it to /api/cron/*.
CRON_SECRET=

# ── Payments (Stripe) ───────────────────────────────────────────────────────
# [optional][SECRET] Secret key (sk_live_... / sk_test_...)
STRIPE_PRIV_KEY=
# [optional][SECRET] Signing secret of the webhook pointed at https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SEC=

# ── Google Calendar sync (optional) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=   # [SECRET]
# Must match the OAuth client: https://YOUR-DOMAIN/crm/api/google/callback
GOOGLE_REDIRECT_URI=
# Defaults to America/Chicago
GOOGLE_CALENDAR_TZ=America/Chicago

# ── Rate limiting (optional; falls back to in-memory) ───────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=   # [SECRET]

# ── Analytics (optional) ────────────────────────────────────────────────────
# [PUBLIC] Microsoft Clarity project ID. Unset = Clarity off.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
